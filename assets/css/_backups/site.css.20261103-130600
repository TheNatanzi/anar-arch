/* =========================================================
   Anar Events — site.css (v1, 3 Nov 2026)
   One file. Mobile first. Palette as custom properties.
   ========================================================= */

/* ---------- Fonts ---------- */
@font-face{font-family:"TT Ramillas";src:url("../fonts/TTRamillas-Regular.woff2") format("woff2");font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:"TT Ramillas";src:url("../fonts/TTRamillas-Italic.woff2") format("woff2");font-weight:400;font-style:italic;font-display:swap}
@font-face{font-family:"TT Ramillas";src:url("../fonts/TTRamillas-Bold.woff2") format("woff2");font-weight:700;font-style:normal;font-display:swap}

/* ---------- Tokens ---------- */
:root{
  --red:#9E1B32;        /* anar red: accent on cream, logo */
  --seed:#E8243F;       /* seed red: big type on brown only */
  --cream:#F0E6D5;      /* the paper */
  --brown:#432617;      /* ink on cream; dark ground */
  --muted:#756053;      /* captions on cream */
  --amber:#FFB401;      /* accent on brown only */
  --gold:#B8922F;       /* foil feel, sparingly */
  --sage:#5E6B4E;
  --olive:#7A8A62;

  --font-latin:"TT Ramillas",Georgia,"Times New Roman",serif;
  --font-fa:"Noto Naskh Arabic",Tahoma,serif;

  --s1:8px;--s2:16px;--s3:32px;--s4:64px;
  --container:1100px;
  --narrow:760px;
  --gutter:48px;
  --header-h:64px;
  --ease:cubic-bezier(.22,.61,.36,1);
  --dur:.9s;
}
@media (min-width:768px){
  :root{--gutter:clamp(64px,11vw,170px);--header-h:96px}
}

/* ---------- Reset-ish ---------- */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;background:var(--cream)}
html.lenis{scroll-behavior:auto}
body{margin:0;background:var(--cream);color:var(--brown);font-family:var(--font-latin);font-size:18px;line-height:28px;font-weight:400;overflow-x:hidden}
img,video,svg{display:block;max-width:100%}
img{height:auto}
h1,h2,h3,h4,p,ul,ol,figure{margin:0}
ul,ol{padding:0;list-style:none}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
:focus{outline:none}
:focus-visible{outline:2px solid var(--red);outline-offset:3px}
.on-brown :focus-visible,.on-brown:focus-visible{outline-color:var(--amber)}
.visually-hidden{position:absolute!important;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.skip-link{position:absolute;left:var(--s2);top:-80px;z-index:100;background:var(--brown);color:var(--cream);padding:var(--s1) var(--s2);border-radius:2px}
.skip-link:focus{top:var(--s2)}

/* ---------- Type ---------- */
h1,h2,h3,h4,.h-display,.h-headline{font-weight:700;line-height:1.1}
.h-display{font-size:clamp(40px,7vw,72px);line-height:1.05}
.h-headline,h2{font-size:clamp(30px,4vw,36px);line-height:1.15}
h3{font-size:clamp(22px,2.6vw,26px);line-height:1.2}
.eyebrow{font-style:italic;font-weight:400;font-size:18px;line-height:28px;color:var(--red)}
.caption{font-style:italic;font-size:14px;line-height:20px;color:var(--muted)}
.lede{font-size:clamp(20px,2.2vw,24px);line-height:1.45}
.fa,[lang="fa"]{font-family:var(--font-fa);font-style:normal!important;letter-spacing:0!important;text-transform:none!important;font-weight:400;font-size:115%;line-height:1.7;direction:rtl}
.fa--big{font-size:clamp(28px,4.4vw,40px);line-height:1.5}
.fa--title{font-size:clamp(34px,5.4vw,56px);line-height:1.4}
.caps{text-transform:uppercase;letter-spacing:.08em}
.measure{max-width:38em}
.muted{color:var(--muted)}

/* ---------- Layout ---------- */
.container{width:100%;max-width:var(--container);margin-inline:auto;padding-inline:var(--gutter)}
.container--narrow{max-width:calc(var(--narrow) + 2*var(--gutter))}
.container--text{max-width:calc(var(--narrow) + 2*var(--gutter))}
main{position:relative;z-index:2}
.section{position:relative;padding-block:clamp(72px,12vh,140px)}
.section--tight{padding-block:clamp(48px,7vh,80px)}
.section__head{text-align:center;margin-bottom:clamp(32px,6vh,64px)}
.section__head .scribble{margin:var(--s2) auto 0}
.two-col{display:grid;gap:var(--s3)}
@media (min-width:768px){.two-col{grid-template-columns:1fr 1fr;gap:var(--s4)}}
.pair{display:grid;gap:var(--s1)}
@media (min-width:768px){
  .pair{grid-template-columns:1fr 1fr;align-items:baseline}
  .pair .fa{text-align:right}
}

/* ---------- Devices ---------- */
/* The kashida line */
.rule{height:2px;background:var(--red);width:100%;border:0;margin:0}
.rule--4{height:4px}
.on-brown .rule{background:var(--cream)}
/* The mirror window: half-circle top, square bottom, 2px line */
.window{--w:100%;position:relative;width:var(--w);border:2px solid var(--red);border-radius:999px 999px 0 0;overflow:hidden;aspect-ratio:3/4;background:var(--cream)}
.window img,.window video{width:100%;height:100%;object-fit:cover}
.window--cream{border-color:var(--cream)}
.window--landscape{aspect-ratio:4/3}
/* scribble (kashida draw-on) */
.scribble{width:min(320px,60vw);height:auto;overflow:visible}
.scribble path{fill:none;stroke:var(--red);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.on-brown .scribble path{stroke:var(--amber)}

/* ---------- Buttons ---------- */
.btn{display:inline-block;padding:14px 28px;border:2px solid var(--red);background:var(--red);color:var(--cream);font-weight:700;line-height:1;letter-spacing:.02em;border-radius:2px;transition:transform .3s var(--ease),background .3s}
.btn:hover{transform:translateY(-2px)}
.btn--ghost{background:transparent;color:var(--red)}
.btn--amber{background:var(--amber);border-color:var(--amber);color:var(--brown)}
.btn--amber:focus-visible{outline-color:var(--cream)}
.link-arrow{font-weight:700;color:var(--red);border-bottom:2px solid var(--red);padding-bottom:2px}
.on-brown .link-arrow{color:var(--cream);border-color:var(--amber)}

/* ---------- Header ---------- */
.site-header{position:absolute;top:0;left:0;right:0;z-index:50;height:var(--header-h);color:var(--brown);transition:background .4s,color .4s,box-shadow .4s}
.js .site-header{position:fixed}
.site-header__inner{height:100%;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding-inline:clamp(16px,3vw,40px);gap:var(--s2)}
.site-logo{display:block;width:180px;justify-self:center;align-self:center}
.site-logo img{width:100%;height:auto}
.site-logo__cream{display:none}
/* index, motion on: the header logo stays empty until the hero wordmark has docked (site.js adds .logo-docked) */
.motion .page-index .site-header--over:not(.logo-docked) .site-logo{visibility:hidden}
.motion .page-index .site-header--over{transition:box-shadow .4s}
/* the travelling wordmark (fixed layer above the header; site.js sets its size and transform) */
.logo-morph{display:none;position:fixed;left:0;top:0;z-index:55;pointer-events:none;transform-origin:0 0;will-change:transform}
.logo-morph img{position:absolute;left:0;top:0;width:100%;height:auto}
.logo-morph__red{opacity:0}
.motion .page-index .logo-morph.is-on{display:block}
.motion .page-index .logo-morph.is-built ~ main .hero__word{visibility:hidden}
.site-nav{display:none}
.site-nav ul{display:flex;gap:clamp(16px,2.4vw,32px)}
.site-nav a,.site-inquire{font-weight:700;letter-spacing:.02em;padding-block:4px;border-bottom:2px solid transparent;transition:border-color .3s}
.site-nav a:hover,.site-nav a[aria-current="page"],.site-inquire:hover{border-bottom-color:currentColor}
.site-inquire{justify-self:end}
.nav-toggle{justify-self:start;width:44px;height:44px;display:grid;place-items:center}
.nav-toggle__bar{display:block;width:24px;height:2px;background:currentColor;position:relative;transition:background .2s}
.nav-toggle__bar::before,.nav-toggle__bar::after{content:"";position:absolute;left:0;width:24px;height:2px;background:currentColor;transition:transform .3s}
.nav-toggle__bar::before{top:-8px}.nav-toggle__bar::after{top:8px}
.nav-toggle[aria-expanded="true"] .nav-toggle__bar{background:transparent}
.nav-toggle[aria-expanded="true"] .nav-toggle__bar::before{transform:translateY(8px) rotate(45deg)}
.nav-toggle[aria-expanded="true"] .nav-toggle__bar::after{transform:translateY(-8px) rotate(-45deg)}
/* mobile drawer */
.site-header.nav-open .site-nav{display:block;position:absolute;top:var(--header-h);left:0;right:0;background:var(--cream);color:var(--brown);border-top:2px solid var(--red);padding:var(--s3) var(--gutter)}
.site-header.nav-open .site-nav ul{flex-direction:column;gap:var(--s2)}
.site-header.nav-open .site-nav a{font-size:24px}
/* solid state (inner pages, and index once scrolled) */
.site-header--solid,.site-header.is-scrolled{background:var(--cream);color:var(--brown);box-shadow:0 1px 0 rgba(67,38,23,.08)}
/* over the hero (index, at rest): cream on video */
.site-header--over:not(.is-scrolled):not(.nav-open){color:var(--cream)}
.site-header--over:not(.is-scrolled):not(.nav-open) .site-logo__red{display:none}
.site-header--over:not(.is-scrolled):not(.nav-open) .site-logo__cream{display:block}
.site-header--over:not(.is-scrolled):not(.nav-open) :focus-visible{outline-color:var(--amber)}
@media (min-width:768px){
  .site-nav{display:block;justify-self:start}
  .nav-toggle{display:none}
  .site-logo{width:240px}
}
/* page top offset for inner pages */
.page-top{padding-top:var(--header-h)}

/* ---------- Side branches (fixed at the viewport edges, always behind the page) ----------
   --art-stop is the x where the art must end: 40px short of the nearest text column edge
   (the narrow text column or the wide container's content edge, whichever is nearer the edge).
   Each branch is masked so nothing is painted past that point, at any width. */
.tree-frame{--art-stop:max(0px,calc(min(calc((100vw - var(--narrow)) / 2),calc(max(0px,(100vw - var(--container)) / 2) + var(--gutter))) - 40px));position:fixed;inset:0;z-index:1;pointer-events:none;overflow:hidden}
.tree-frame img{position:absolute;display:block;will-change:transform;max-width:none}
.tree-frame [data-layer="leftBranch"],.tree-frame [data-layer="rightBranch"]{top:25vh;width:clamp(220px,26vw,520px);height:auto;display:none;opacity:.9}
.tree-frame [data-layer="leftBranch"]{left:0;-webkit-mask-image:linear-gradient(to right,#000 calc(var(--art-stop) - 90px),transparent var(--art-stop));mask-image:linear-gradient(to right,#000 calc(var(--art-stop) - 90px),transparent var(--art-stop))}
.tree-frame [data-layer="rightBranch"]{right:0;-webkit-mask-image:linear-gradient(to left,#000 calc(var(--art-stop) - 90px),transparent var(--art-stop));mask-image:linear-gradient(to left,#000 calc(var(--art-stop) - 90px),transparent var(--art-stop))}
@media (min-width:768px){
  .tree-frame [data-layer="leftBranch"],.tree-frame [data-layer="rightBranch"]{display:block}
}
/* ---------- Static art bands (in flow, nothing ever sits on them) ----------
   The leaf band sits at the foot of the page content, directly above the brown CTA band;
   the ground band sits at the top of the footer and fades into the brown. */
   Leaf band: tall enough that the three painted pomegranates (rows 55-88% of the art) sit whole;
   the art is pinned near its foot (object-position 90%) and the cream fade only reaches the leaf tips above the fruit. */
.leaf-band{position:relative;z-index:2;width:100%;height:min(42vh,34vw);overflow:hidden;background:var(--cream)}
.leaf-band img{width:100%;height:100%;object-fit:cover;object-position:center 90%;-webkit-mask-image:linear-gradient(to top,#000 78%,transparent 100%);mask-image:linear-gradient(to top,#000 78%,transparent 100%)}
.ground-band{width:100%;height:min(34vh,28vw);overflow:hidden;margin-top:calc(-1 * var(--s4));margin-bottom:var(--s3)}
.ground-band img{width:100%;height:100%;object-fit:cover;object-position:center bottom;-webkit-mask-image:linear-gradient(to bottom,#000 0%,#000 35%,transparent 100%);mask-image:linear-gradient(to bottom,#000 0%,#000 35%,transparent 100%)}

/* ---------- Hero ---------- */
.hero{position:relative;height:100vh;height:100svh;min-height:560px;overflow:hidden;background:var(--brown);color:var(--cream)}
.hero__video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.hero__shade{position:absolute;left:50%;top:9vh;transform:translateX(-50%);width:min(72vw,520px);aspect-ratio:3/4;max-height:72vh;border-radius:999px 999px 0 0;box-shadow:0 0 0 200vmax rgba(67,38,23,.68)}
.hero__window{position:absolute;left:50%;top:9vh;transform:translateX(-50%);width:min(72vw,520px);aspect-ratio:3/4;max-height:72vh;border:2px solid var(--cream);border-radius:999px 999px 0 0}
.hero__cloud{position:absolute;left:-10vw;bottom:-10vh;width:120vw;height:auto;pointer-events:none}
.hero__cloud--2{left:-20vw;width:140vw;bottom:-18vh}
/* phone: 9vh (not the morning 6vh) so the two-line tagline never touches the wordmark */
.hero__word{position:absolute;left:50%;bottom:9vh;transform:translateX(-50%);width:min(92vw,1100px);margin:0}
.hero__word img{width:100%;height:auto}
.hero__tag{position:absolute;left:0;right:0;bottom:2vh;text-align:center;font-style:italic;font-size:14px;line-height:20px;letter-spacing:.02em;padding-inline:var(--s2)}
.hero__fade{position:absolute;inset:0;background:var(--cream);opacity:0;pointer-events:none}
@media (min-width:768px){
  .hero__shade,.hero__window{top:10vh;width:min(44vw,560px);max-height:70vh}
  .hero__word{bottom:8vh}
  .hero__tag{bottom:3vh;font-size:16px}
}

/* ---------- Page band (inner page hero): brown poster band ---------- */
.band{background:var(--brown);color:var(--cream);padding-block:clamp(56px,10vh,112px)}
.band .eyebrow{color:var(--amber)}
.band__title{display:grid;gap:var(--s2)}
@media (min-width:768px){.band__title{grid-template-columns:1fr 1fr;align-items:end}.band__title .fa{text-align:right}}

/* ---------- Statement ---------- */
.statement{text-align:center}
.statement .scribble{margin:var(--s1) auto var(--s3)}
.statement__text{font-size:clamp(26px,4.6vw,56px);line-height:1.18;letter-spacing:.06em;text-transform:uppercase;font-weight:700}

/* ---------- Who / pillars ---------- */
.pillars{display:grid;gap:var(--s3);counter-reset:pillar}
@media (min-width:768px){.pillars{grid-template-columns:repeat(3,1fr)}}
.pillar{border-top:2px solid var(--red);padding-top:var(--s2)}
.pillar__n{display:block;font-style:italic;color:var(--red);margin-bottom:var(--s1)}
.pillar h3{margin-bottom:var(--s1)}

/* ---------- Accordion (The celebrations) ---------- */
.accordion{display:grid;gap:var(--s2)}
.accordion__panel{position:relative;overflow:hidden;background:var(--brown);color:var(--cream);border-radius:2px;min-height:360px}
.accordion__media{position:absolute;inset:0}
.accordion__media img{width:100%;height:100%;object-fit:cover;transition:filter .6s var(--ease),transform .6s var(--ease)}
.accordion__media::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(67,38,23,.85) 0%,rgba(67,38,23,.25) 55%,rgba(67,38,23,.1) 100%)}
.accordion__trigger{position:absolute;inset:0;width:100%;text-align:left;z-index:2}
.accordion__trigger:focus-visible{outline:2px solid var(--amber);outline-offset:-6px}
.accordion__label{position:absolute;left:var(--s2);top:var(--s2);font-weight:700;letter-spacing:.06em;text-transform:uppercase;font-size:14px;z-index:1;display:none}
.accordion__body{position:relative;z-index:1;padding:var(--s3) var(--s2) var(--s2);display:grid;gap:var(--s1);min-height:100%;align-content:end;pointer-events:none}
.accordion__body h3{font-size:clamp(26px,3vw,34px)}
.accordion__body .fa{color:var(--cream);opacity:.9}
.accordion__body p:last-child{max-width:34em;opacity:.95}
@media (min-width:768px){
  .accordion{display:flex;gap:var(--s1);height:min(68vh,620px)}
  .accordion__panel{flex:1 1 0;min-height:0;transition:flex .7s var(--ease)}
  .accordion__panel.is-open{flex:6 1 0}
  .accordion__panel:not(.is-open) .accordion__media img{filter:blur(6px);transform:scale(1.08)}
  .accordion__panel:not(.is-open) .accordion__body{opacity:0;transition:opacity .25s}
  .accordion__panel.is-open .accordion__body{opacity:1;transition:opacity .6s .25s}
  .accordion__panel:not(.is-open) .accordion__label{display:block;writing-mode:vertical-rl;transform:rotate(180deg);left:auto;right:50%;top:auto;bottom:var(--s3);transform-origin:center;transform:translateX(50%) rotate(180deg)}
  .accordion__body{padding:var(--s4) var(--s3) var(--s3)}
}

/* ---------- Quote ---------- */
.quote{text-align:center}
.quote blockquote{margin:0;font-style:italic;font-size:clamp(26px,4vw,44px);line-height:1.25;max-width:22em;margin-inline:auto}
.quote .signature{width:180px;height:auto;margin:var(--s3) auto var(--s1)}
.quote .signature path{fill:none;stroke:var(--red);stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
.quote figcaption{font-style:italic;color:var(--muted)}

/* ---------- Journey ---------- */
.journey__track{position:relative}
.journey__line{position:absolute;pointer-events:none}
.journey__line path{fill:none;stroke:var(--red);stroke-width:2;vector-effect:non-scaling-stroke}
.journey__line--h{display:none}
.journey__line--v{left:11px;top:0;width:2px;height:100%}
.journey__stops{display:grid;gap:var(--s3);padding-left:40px}
.journey__stop{position:relative;display:grid;gap:2px}
.journey__dot{position:absolute;left:-40px;top:10px;width:14px;height:14px;border-radius:50%;background:var(--red);transform-origin:center}
.journey__fa{font-size:20px;line-height:1.5;text-align:left;direction:rtl}
.journey__en{font-weight:700}
.journey__note{font-size:14px;line-height:20px;color:var(--muted);font-style:italic}
@media (min-width:768px){
  .journey__line--h{display:block;left:0;right:0;top:7px;width:100%;height:2px}
  .journey__line--v{display:none}
  .journey__stops{grid-template-columns:repeat(9,1fr);gap:var(--s1);padding-left:0;padding-top:var(--s3)}
  .journey__stop{text-align:center;justify-items:center}
  .journey__dot{left:50%;top:-32px;margin-left:-7px}
  .journey__fa{text-align:center;direction:rtl}
  .journey__en{font-size:16px;line-height:22px}
  .journey__note{display:none}
}

/* ---------- Inquire form ---------- */
.inquire{background:transparent}
.form{display:grid;gap:var(--s3)}
.form__row{display:grid;gap:var(--s3)}
@media (min-width:600px){.form__row{grid-template-columns:1fr 1fr}}
.field{display:grid;gap:var(--s1)}
.field label,.fieldset legend{font-weight:700;font-size:16px;line-height:22px}
.field input,.field textarea,.field select{font:inherit;color:var(--brown);background:transparent;border:1px solid var(--brown);border-radius:2px;padding:12px 14px;width:100%}
.field input:focus-visible,.field textarea:focus-visible,.field select:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.field textarea{min-height:140px;resize:vertical}
.fieldset{border:0;padding:0;margin:0;display:grid;gap:var(--s1)}
.checks{display:grid;gap:var(--s1);grid-template-columns:1fr 1fr}
@media (min-width:600px){.checks{grid-template-columns:repeat(3,1fr)}}
.check{display:flex;gap:10px;align-items:center;font-size:16px;line-height:22px}
.check input{width:18px;height:18px;accent-color:var(--red);margin:0}
.form__note{font-size:14px;line-height:20px;color:var(--muted);font-style:italic}

/* ---------- CTA band + footer ---------- */
.cta{position:relative;background:var(--brown);color:var(--cream);text-align:center;padding-block:clamp(72px,14vh,160px);min-height:70vh;display:grid;align-content:center}
.cta__title{font-size:clamp(40px,8vw,112px);line-height:1;letter-spacing:.04em;text-transform:uppercase;margin-bottom:var(--s2)}
.cta .fa{color:var(--cream)}
.cta__line{font-size:clamp(18px,1.6vw,22px);line-height:1.5;margin:0 auto}
.cta__actions{margin-top:clamp(28px,4vh,44px);display:grid;gap:var(--s2);justify-items:center}
.btn--big{padding:20px 40px;font-size:clamp(18px,1.5vw,21px)}
.btn--cream{background:transparent;border-color:var(--cream);color:var(--cream)}
.btn--cream:hover{background:var(--cream);color:var(--brown)}
.cta__contact{font-size:15px;line-height:22px;letter-spacing:.02em;color:rgba(240,230,213,.8);display:flex;flex-wrap:wrap;justify-content:center;gap:0 12px}
.cta__contact a{border-bottom:1px solid transparent;transition:border-color .3s,color .3s}
.cta__contact a:hover{color:var(--cream);border-bottom-color:var(--amber)}
/* Variant A "Poster": 1px cream inset frame, wordmark on top, the tagline inside the kashida line */
.cta--poster{padding-block:clamp(96px,16vh,180px)}
.cta--poster::before{content:"";position:absolute;inset:16px;border:1px solid var(--cream);pointer-events:none}
@media (min-width:768px){.cta--poster::before{inset:24px}}
.cta--poster .container{position:relative;z-index:1}
.cta__wordmark{width:clamp(132px,13vw,176px);height:auto;display:block;margin:0 auto clamp(32px,6vh,56px)}
.cta--poster .cta__title{font-size:clamp(34px,7.4vw,104px);letter-spacing:.08em;margin-bottom:clamp(24px,4vh,40px)}
.kashida-tagline{display:flex;align-items:center;gap:clamp(14px,2vw,24px);width:min(100%,760px);margin:0 auto clamp(20px,3vh,28px)}
.kashida-tagline::before,.kashida-tagline::after{content:"";flex:1 1 0;height:2px;background:var(--cream)}
.kashida-tagline .fa{flex:0 0 auto;white-space:nowrap;margin:0;line-height:1.4}
/* Variant B "Mark": the painted split pomegranate above the title, Persian right-aligned on a short kashida, cream rules top and bottom */
.cta--mark{border-top:1px solid var(--cream);border-bottom:1px solid var(--cream)}
.cta__mark{width:120px;height:auto;display:block;margin:0 auto clamp(24px,4vh,40px)}
.cta__titleblock{display:inline-grid;justify-items:stretch;margin-bottom:clamp(24px,4vh,36px)}
.cta--mark .cta__title{margin-bottom:var(--s1)}
.cta__fa-row{display:flex;align-items:center;justify-content:flex-end;gap:16px}
.cta__fa-row::before{content:"";width:clamp(48px,8vw,96px);height:2px;background:var(--cream)}
.cta__fa-row .fa{margin:0;line-height:1.4}
.btn--amber:hover{background:var(--amber)}
.site-footer{position:relative;z-index:2;background:var(--brown);color:var(--cream);border-top:2px solid rgba(240,230,213,.25);padding-block:var(--s4) var(--s3)}
.site-footer__grid{display:grid;gap:var(--s3)}
@media (min-width:768px){.site-footer__grid{grid-template-columns:1.2fr 1fr 1fr;align-items:start}}
.site-footer__logo{width:min(100%,320px);height:auto}
.site-footer address{font-style:normal;display:grid;gap:4px}
.site-footer a:hover{border-bottom:2px solid var(--amber)}
.site-footer__fa{font-size:20px;line-height:1.7;text-align:left}
@media (min-width:768px){.site-footer__fa{text-align:right}}
.site-footer__legal{margin-top:var(--s3);font-size:14px;line-height:20px;opacity:.75;display:flex;flex-wrap:wrap;gap:var(--s2);justify-content:space-between}

/* ---------- Weddings page ---------- */
.tradition{border-top:2px solid var(--red)}
.tradition__grid{display:grid;gap:var(--s3)}
@media (min-width:900px){
  .tradition__grid{grid-template-columns:1fr 1fr;align-items:start;gap:var(--s4)}
  .tradition--flip .tradition__grid > .tradition__text{order:2}
}
.tradition__title{display:grid;gap:var(--s1);margin-bottom:var(--s2)}
@media (min-width:600px){.tradition__title{grid-template-columns:1fr 1fr;align-items:baseline}.tradition__title .fa{text-align:right}}
.tradition__text p+p{margin-top:var(--s2)}
.tradition__media .window{max-width:440px;margin-inline:auto}
.tradition__media figcaption{margin-top:var(--s1);text-align:center}
.seasonal{background:var(--cream);border:2px solid var(--red);padding:var(--s3)}

/* ---------- How we work page ---------- */
.steps{position:relative;display:grid;gap:var(--s4);padding-left:40px}
.steps__line{position:absolute;left:11px;top:0;width:2px;height:100%}
.steps__line path{fill:none;stroke:var(--red);stroke-width:2;vector-effect:non-scaling-stroke}
.step{position:relative;display:grid;gap:var(--s1)}
.step__dot{position:absolute;left:-40px;top:10px;width:14px;height:14px;border-radius:50%;background:var(--red)}
.step__n{font-style:italic;color:var(--red)}
.step h3{font-size:clamp(24px,3vw,32px)}
.step .fa{text-align:left}
.faq{display:grid;gap:0;border-top:2px solid var(--red)}
.faq details{border-bottom:1px solid var(--red)}
.faq summary{cursor:pointer;list-style:none;padding:var(--s2) 0;font-weight:700;font-size:20px;line-height:28px;display:flex;justify-content:space-between;gap:var(--s2)}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";color:var(--red);flex:0 0 auto}
.faq details[open] summary::after{content:"\2013"}
.faq .faq__a{padding:0 0 var(--s3);max-width:38em}
.you-get{display:grid;gap:var(--s2)}
@media (min-width:768px){.you-get{grid-template-columns:1fr 1fr}}
.you-get li{border-top:1px solid var(--red);padding-top:var(--s1)}
.you-get li strong{display:block}

/* ---------- About page ---------- */
.letter{font-size:clamp(20px,2.4vw,26px);line-height:1.5;display:grid;gap:var(--s2)}
.letter__sign{font-style:italic;color:var(--muted);font-size:18px}
.story{display:grid;gap:var(--s3)}
.story__photos{display:grid;gap:var(--s3)}
@media (min-width:768px){.story__photos{grid-template-columns:repeat(3,1fr);align-items:end}}
.story__photos figure{margin:0}
.story__photos img{width:100%;height:auto;aspect-ratio:3/4;object-fit:cover}
.story__photos figcaption{margin-top:var(--s1)}
.promise{display:grid;gap:var(--s2)}
.promise li{display:grid;grid-template-columns:48px 1fr;gap:var(--s2);border-top:2px solid var(--red);padding-top:var(--s2);font-size:clamp(20px,2.2vw,24px);line-height:1.4}
.promise li b{color:var(--red);font-weight:700}
.behaviour{display:grid;gap:var(--s2);grid-template-columns:1fr 1fr}
@media (min-width:768px){.behaviour{grid-template-columns:repeat(4,1fr)}}
.behaviour li strong{display:block}
.behaviour li{font-size:16px;line-height:24px;border-top:1px solid var(--red);padding-top:var(--s1)}

/* ---------- Reveal (only hidden when JS + motion are on) ---------- */
.motion .reveal{opacity:0;transform:translateY(24px)}
.motion .reveal-img{transform:scale(1.02)}
.motion .reveal.is-in{opacity:1;transform:none}
.motion .stagger > *{opacity:0;transform:translateY(16px)}

/* ---------- Reduced motion ---------- */
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{transition-duration:.01ms!important;animation-duration:.01ms!important}
}
