        <p class="fa" lang="fa" dir="rtl">شروع برنامه‌ریزی</p>
      </div>
      <h2 id="inquire-title" class="reveal" style="margin:8px 0 16px">Begin the conversation</h2>
      <p class="reveal measure" style="margin-bottom:40px">Thank you for writing. Tell us about your family. We reply within one business day. Couples and parents are both welcome to inquire.</p>
      <!-- Formspree: replace FORMSPREE_ID with the real form id -->
      <form class="form" action="https://formspree.io/f/FORMSPREE_ID" method="POST" data-ajax>
